APP_NAME="Aether Market Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Aether Market Intelligence - Local 9Router Settings
AI_ROUTER_ENDPOINT="http://127.0.0.1:20128/v1"
AI_MODEL_ID="ag/gemini-3.8-flash-high"
AI_API_KEY=""
AI_ROUTER_TIMEOUT=30
AI_ROUTER_MAX_TOKENS=2500
AI_LIVE_INFERENCE_ENABLED=false

# IDX Edge - backend only; rotate any key exposed in chat before use
IDX_EDGE_ENABLED=false
IDX_EDGE_BASE_URL="https://stock.arjum.com"
IDX_EDGE_API_KEY=""
IDX_EDGE_TIMEOUT=10
IDX_EDGE_DAILY_BUDGET=800
IDX_EDGE_DAILY_RESERVE=200
# Conservative local guard until provider documents RPM/concurrency.
IDX_EDGE_REQUESTS_PER_MINUTE=10
IDX_EDGE_CACHE_TTL_SECONDS=30

# Konfigurasi Screening Akumulasi Broker V1
SCREENING_BROKER_ACCUMULATION_VERSION=BROKER_ACCUMULATION_SCREENING_V1
SCREENING_MIN_AVG_VOLUME=1000000
SCREENING_MAX_RETURN_1M_PCT=5.0
SCREENING_MIN_RETURN_1M_PCT=-30.0
SCREENING_MAX_DIST_FROM_LOW_PCT=15.0
SCREENING_MIN_SESSION_COUNT=10
SCREENING_SHORTLIST_LIMIT=5
SCREENING_TOP3_MIN_NET_BUY_IDR=1000000000.0
SCREENING_TOP3_MIN_CONCENTRATION_PCT=10.0

HERMES_CLI_COMMAND=hermes
HERMES_ORCHESTRATOR_ENABLED=false
HERMES_PROFILE=aether-prod
HERMES_RUN_BUDGET_SECONDS=60

